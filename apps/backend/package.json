    "@types/node": "^18.19.130",
    "@types/pg": "^8.20.0",
    "eslint": "^8.57.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "prisma": "^7.7.0",
    "ts-node": "^10.9.2",
