{
  "name": "fastify-vue3-admin",
  "version": "0.1.0",
  "description": "Fastify + Vue3 Admin Monorepo",
  "scripts": {
    "dev:admin": "pnpm --filter admin dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev": "pnpm -r --parallel -filter '!admin' dev",
    "lint": "pnpm exec eslint . --max-warnings 0",
    "lint:fix": "pnpm exec eslint . --fix",
    "lint:backend": "pnpm exec eslint apps/backend/src/ -c eslint.config.mjs --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "commit": "cz"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "commitizen": "^4.3.1",
    "cz-git": "^1.12.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1"
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  }
}
